# Copy to .env.local for development with vercel dev.
APP_ORIGIN=http://localhost:3000
FIREBASE_DATABASE_URL=https://dsgen-8cf88-default-rtdb.asia-southeast1.firebasedatabase.app

# Use the Web API key and Google OAuth web client ID for dsgen-8cf88.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com

# Server only. Replace the example object with your service account JSON
# on one line, inside single quotes. Keep the JSON newline escapes in the key.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"dsgen-8cf88","client_email":"replace-with-service-account-email","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"}'
